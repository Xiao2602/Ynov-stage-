{
	"info": {
		"_postman_id": "ynov-absence-backend-collection",
		"name": "YNOV Absence Backend API",
		"description": "Collection Postman pour la gestion de l'authentification et des utilisateurs",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"user@ynov.com\",\n  \"password\": \"Password123!\"\n}"
						},
						"url": {
							"raw": "http://localhost:5000/api/auth/login",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "5000",
							"path": [
								"api",
								"auth",
								"login"
							]
						}
					}
				},
				{
					"name": "Reset Password",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"user@ynov.com\"\n}"
						},
						"url": {
							"raw": "http://localhost:5000/api/auth/reset-password",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "5000",
							"path": [
								"api",
								"auth",
								"reset-password"
							]
						}
					}
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"url": {
							"raw": "http://localhost:5000/api/auth/logout",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "5000",
							"path": [
								"api",
								"auth",
								"logout"
							]
						}
					}
				}
			]
		},
		{
			"name": "Users",
			"item": [
				{
					"name": "Create User (Admin / RH)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer YOUR_ADMIN_ID_TOKEN_HERE"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"nouvel.etudiant@ynov.com\",\n  \"password\": \"Password123!\",\n  \"displayName\": \"Karim Bennani\",\n  \"role\": \"student\",\n  \"department\": \"Informatique\"\n}"
						},
						"url": {
							"raw": "http://localhost:5000/api/users/create",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "5000",
							"path": [
								"api",
								"users",
								"create"
							]
						}
					}
				},
				{
					"name": "Get All Users",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer YOUR_ID_TOKEN_HERE"
							}
						],
						"url": {
							"raw": "http://localhost:5000/api/users",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "5000",
							"path": [
								"api",
								"users"
							]
						}
					}
				}
			]
		}
	]
